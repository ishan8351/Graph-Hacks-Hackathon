# Backend Environment Variables (Local or Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Optional: enables graph-grounded natural-language answers in Company Brain.
# The key is sent only from the backend to Google's Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional FalkorDB Cloud settings:
# FALKORDB_USERNAME=falkordb
# FALKORDB_SSL=false
# FALKORDB_URL=falkor://...
PORT=8000
# Allowed frontend origins (comma-separated or wildcard; Vercel .vercel.app is allowed by default)
# CORS_ORIGINS=https://my-app.vercel.app

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
